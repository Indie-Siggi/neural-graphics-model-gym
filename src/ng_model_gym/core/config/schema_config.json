{
    "config_schema_version": {
        "default": "10",
        "description": "Config schema version. Used to check compatibility.",
        "type": "string"
    },
    "model": {
        "discriminator": {
            "propertyName": "model_source"
        },
        "oneOf": [
            {
                "discriminator": {
                    "propertyName": "name"
                },
                "oneOf": [
                    {
                        "name": {
                            "const": "nss-v1",
                            "type": "string"
                        },
                        "model_source": {
                            "const": "prebuilt",
                            "type": "string"
                        },
                        "processing_backend": {
                            "default": "slang",
                            "description": "Backend for model pre/post processing. 'slang' requires an NVIDIA GPU. 'torch' supports processing on both CPU and GPU ",
                            "enum": [
                                "slang",
                                "torch"
                            ],
                            "type": "string"
                        },
                        "scale": {
                            "default": 2.0,
                            "description": "Upscale parameter for the NSS model. NSS v1 train/eval supports numeric scale values greater than 1.0.",
                            "exclusiveMinimum": 1.0,
                            "type": "number"
                        },
                        "recurrent_samples": {
                            "description": "Number of recurrent samples",
                            "exclusiveMinimum": 1,
                            "type": "integer"
                        },
                        "quality": {
                            "anyOf": [
                                {
                                    "enum": [
                                        "high",
                                        "mid",
                                        "low"
                                    ],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "default": null,
                            "description": "NSS v1 quality mode."
                        },
                        "nss_v1_luma_derivative": {
                            "default": true,
                            "description": "Enable NSS v1 luminance-derivative features in shader-accurate preprocessing. Disable to evaluate the alternate runtime variant.",
                            "type": "boolean"
                        },
                        "nss_v1_sharp_theta": {
                            "default": true,
                            "description": "Enable NSS v1 sharp-theta weighting in shader-accurate postprocessing. Disable to evaluate the alternate runtime variant.",
                            "type": "boolean"
                        },
                        "gt_history_augmentation": {
                            "default": true,
                            "description": "Enable NSS v1 training-time recurrent history augmentation. When enabled, the first recurrent frame can initialize history from ground truth instead of the reset history buffer.",
                            "type": "boolean"
                        },
                        "gt_history_augmentation_chance": {
                            "default": 30.0,
                            "description": "Percent chance per batch element of replacing first-frame recurrent history with ground truth when gt_history_augmentation is enabled.",
                            "maximum": 100.0,
                            "minimum": 0.0,
                            "type": "number"
                        }
                    },
                    {
                        "name": {
                            "const": "nfru-v1",
                            "type": "string"
                        },
                        "model_source": {
                            "const": "prebuilt",
                            "type": "string"
                        },
                        "processing_backend": {
                            "default": "slang",
                            "description": "Backend for model pre/post processing. 'slang' requires an NVIDIA GPU. 'torch' supports processing on both CPU and GPU ",
                            "enum": [
                                "slang",
                                "torch"
                            ],
                            "type": "string"
                        },
                        "scale_factor": {
                            "default": 2.0,
                            "description": "Interpolation scale factor for the NFRU model. Only 2 (or 2.0) is currently supported.",
                            "maximum": 2.0,
                            "minimum": 2.0,
                            "type": "number"
                        },
                        "legacy_nfru_capture_paths": {
                            "description": "Path substrings identifying legacy NFRU captures that should use the old window stride behavior.",
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "dynamic_mask_is_runtime_accurate": {
                            "default": false,
                            "description": "Whether to use runtime-accurate dynamic masks in NFRU preprocessing and motion-vector warping.",
                            "type": "boolean"
                        },
                        "mv_similarity_threshold": {
                            "anyOf": [
                                {
                                    "minimum": 0.0,
                                    "type": "number"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "default": null,
                            "description": "Motion-vector similarity threshold used by NFRU dynamic masks. Defaults to a value specific to the selected dynamic mask implementation."
                        }
                    }
                ]
            },
            {
                "name": {
                    "description": "Model name",
                    "type": "string"
                },
                "model_source": {
                    "const": "custom",
                    "type": "string"
                }
            }
        ]
    },
    "dataset": {
        "name": {
            "description": "Dataset name",
            "type": "string"
        },
        "version": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Dataset version"
        },
        "path": {
            "train": {
                "anyOf": [
                    {
                        "format": "path",
                        "type": "string"
                    },
                    {
                        "type": "null"
                    }
                ],
                "default": null,
                "description": "Train dataset directory path"
            },
            "validation": {
                "anyOf": [
                    {
                        "format": "path",
                        "type": "string"
                    },
                    {
                        "type": "null"
                    }
                ],
                "default": null,
                "description": "Validation dataset directory path"
            },
            "test": {
                "anyOf": [
                    {
                        "format": "path",
                        "type": "string"
                    },
                    {
                        "type": "null"
                    }
                ],
                "default": null,
                "description": "Test dataset directory path"
            },
            "checks": {
                "anyOf": [
                    {},
                    {
                        "type": "null"
                    }
                ],
                "default": null,
                "description": "Named check sets: extra validation directories in the validation set's format (e.g. crops of one hard case), scored with the validation set on every validation epoch and logged to TensorBoard as Check/<name>/<metric>. They do not affect the best checkpoint. Each needs at least train.batch_size samples (incomplete batches are dropped)."
            }
        },
        "color_preprocessing": {
            "anyOf": [
                {
                    "train": {
                        "anyOf": [
                            {
                                "pipeline": {
                                    "description": "Ordered color stages. Nested lists indicate mutually exclusive stages to sample from during random-effects training.",
                                    "items": {
                                        "anyOf": [
                                            {
                                                "type": "string"
                                            },
                                            {},
                                            {
                                                "items": {
                                                    "anyOf": [
                                                        {
                                                            "type": "string"
                                                        },
                                                        {}
                                                    ]
                                                },
                                                "type": "array"
                                            }
                                        ]
                                    },
                                    "type": "array"
                                },
                                "exposure": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "const": "auto",
                                            "type": "string"
                                        },
                                        {
                                            "items": {
                                                "type": "number"
                                            },
                                            "maxItems": 2,
                                            "minItems": 2,
                                            "type": "array"
                                        }
                                    ],
                                    "default": 2.0,
                                    "description": "NFRU color-preprocessing exposure. Use a fixed log exposure, \"auto\" to compute exposure from average image brightness using auto_exposure_key_value as the target brightness, or [min, max] to randomly resample exposure within that range."
                                },
                                "auto_exposure_key_value": {
                                    "default": 1.0,
                                    "description": "Target brightness when exposure is set to \"auto\".",
                                    "type": "number"
                                },
                                "auto_exposure_variance": {
                                    "anyOf": [
                                        {},
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "default": null,
                                    "description": "Optional per-time-index multiplier applied to auto exposure."
                                }
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Color preprocessing applied to training data."
                    },
                    "validation": {
                        "anyOf": [
                            {
                                "pipeline": {
                                    "description": "Ordered color stages. Nested lists indicate mutually exclusive stages to sample from during random-effects training.",
                                    "items": {
                                        "anyOf": [
                                            {
                                                "type": "string"
                                            },
                                            {},
                                            {
                                                "items": {
                                                    "anyOf": [
                                                        {
                                                            "type": "string"
                                                        },
                                                        {}
                                                    ]
                                                },
                                                "type": "array"
                                            }
                                        ]
                                    },
                                    "type": "array"
                                },
                                "exposure": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "const": "auto",
                                            "type": "string"
                                        },
                                        {
                                            "items": {
                                                "type": "number"
                                            },
                                            "maxItems": 2,
                                            "minItems": 2,
                                            "type": "array"
                                        }
                                    ],
                                    "default": 2.0,
                                    "description": "NFRU color-preprocessing exposure. Use a fixed log exposure, \"auto\" to compute exposure from average image brightness using auto_exposure_key_value as the target brightness, or [min, max] to randomly resample exposure within that range."
                                },
                                "auto_exposure_key_value": {
                                    "default": 1.0,
                                    "description": "Target brightness when exposure is set to \"auto\".",
                                    "type": "number"
                                },
                                "auto_exposure_variance": {
                                    "anyOf": [
                                        {},
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "default": null,
                                    "description": "Optional per-time-index multiplier applied to auto exposure."
                                }
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Color preprocessing applied to validation data."
                    },
                    "test": {
                        "anyOf": [
                            {
                                "pipeline": {
                                    "description": "Ordered color stages. Nested lists indicate mutually exclusive stages to sample from during random-effects training.",
                                    "items": {
                                        "anyOf": [
                                            {
                                                "type": "string"
                                            },
                                            {},
                                            {
                                                "items": {
                                                    "anyOf": [
                                                        {
                                                            "type": "string"
                                                        },
                                                        {}
                                                    ]
                                                },
                                                "type": "array"
                                            }
                                        ]
                                    },
                                    "type": "array"
                                },
                                "exposure": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "const": "auto",
                                            "type": "string"
                                        },
                                        {
                                            "items": {
                                                "type": "number"
                                            },
                                            "maxItems": 2,
                                            "minItems": 2,
                                            "type": "array"
                                        }
                                    ],
                                    "default": 2.0,
                                    "description": "NFRU color-preprocessing exposure. Use a fixed log exposure, \"auto\" to compute exposure from average image brightness using auto_exposure_key_value as the target brightness, or [min, max] to randomly resample exposure within that range."
                                },
                                "auto_exposure_key_value": {
                                    "default": 1.0,
                                    "description": "Target brightness when exposure is set to \"auto\".",
                                    "type": "number"
                                },
                                "auto_exposure_variance": {
                                    "anyOf": [
                                        {},
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "default": null,
                                    "description": "Optional per-time-index multiplier applied to auto exposure."
                                }
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Color preprocessing applied to test data."
                    }
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Required lowercase color pipeline configuration for train, validation, and test."
        },
        "exposure": {
            "anyOf": [
                {
                    "minimum": 0.0,
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "NSS dataset exposure override: a fixed log exposure value. Use null to read per-frame exposure from dataset metadata."
        },
        "tonemapper": {
            "anyOf": [
                {
                    "description": "Supported modes for tone mapping.",
                    "enum": [
                        "reinhard",
                        "karis",
                        "log",
                        "log10",
                        "log_norm",
                        "aces"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "NSS dataset tonemapper method."
        },
        "health_check": {
            "description": "Run health check on given dataset. health_check() must be implemented in the Dataset.",
            "type": "boolean"
        },
        "gt_augmentation": {
            "description": "Enable dataset augmentations e.g flips, rotations",
            "type": "boolean"
        },
        "num_workers": {
            "description": "Number of dataloader workers to use",
            "minimum": 0,
            "type": "integer"
        },
        "window_stride": {
            "default": 1,
            "description": "Frames between the starts of consecutive recurrent training/validation windows (1: a window at every frame). The last window of each sequence is always kept, so every frame stays covered.",
            "minimum": 1,
            "type": "integer"
        },
        "prefetch_factor": {
            "description": "Number of batches loaded in advance by each dataloader worker. Used only if num_workers > 0",
            "exclusiveMinimum": 0,
            "type": "integer"
        },
        "align_data": {
            "default": true,
            "description": "Whether to align loaded dataset features to the model input set.",
            "type": "boolean"
        },
        "extension": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": ".safetensors",
            "description": "File extension passed to the selected dataset loader. Defaults to '.safetensors'."
        }
    },
    "output": {
        "dir": {
            "description": "Directory path for storing training output",
            "format": "path",
            "type": "string"
        },
        "export_frame_png": {
            "description": "Write per-frame 8-bit display/tonemapped visualization PNGs during model evaluation.",
            "type": "boolean"
        },
        "export_frame_exr": {
            "default": false,
            "description": "Write per-frame float32 RGB prediction and ground-truth EXRs during model evaluation. The model selects the exported color representation.",
            "type": "boolean"
        },
        "tensorboard_output_dir": {
            "anyOf": [
                {
                    "format": "path",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Output directory for tensorboard logs. If None is passed, disable tensorboard"
        },
        "export": {
            "dynamic_shape": {
                "description": "Enable dynamic input shapes for the exported model ",
                "type": "boolean"
            },
            "vgf_static_input_shape": {
                "anyOf": [
                    {
                        "description": "One or more static VGF input shape definition (4 positive ints each)",
                        "items": {
                            "items": {
                                "exclusiveMinimum": 0,
                                "type": "integer"
                            },
                            "maxItems": 4,
                            "minItems": 4,
                            "type": "array"
                        },
                        "minItems": 1,
                        "type": "array"
                    },
                    {
                        "type": "null"
                    }
                ],
                "default": null
            },
            "vgf_output_dir": {
                "description": "Output directory for the VGF file",
                "format": "path",
                "type": "string"
            }
        }
    },
    "train": {
        "batch_size": {
            "description": "Number of samples processed together in one pass before updating model weights",
            "minimum": 1,
            "type": "integer"
        },
        "seed": {
            "description": "Seed for random number generation",
            "minimum": 0,
            "type": "integer"
        },
        "perform_validate": {
            "description": "Perform validation at the end of specific training epochs, as set by the validate_frequency field.",
            "type": "boolean"
        },
        "compile": {
            "default": false,
            "description": "Enable torch.compile for the training step.",
            "type": "boolean"
        },
        "gradient_accumulation_steps": {
            "default": 1,
            "description": "Number of batches whose gradients are summed before each optimizer step: the effective batch size is batch_size * gradient_accumulation_steps, at the memory cost of batch_size.",
            "minimum": 1,
            "type": "integer"
        },
        "log_interval": {
            "default": 1,
            "description": "Batches between progress-bar/TensorBoard updates. Train metrics are also only updated on these batches (a sample; updating them costs ~28 % of a step), while the loss average and validation use every batch.",
            "minimum": 1,
            "type": "integer"
        },
        "grad_clip_norm": {
            "anyOf": [
                {
                    "exclusiveMinimum": 0.0,
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Clip the global gradient norm to this value before each optimizer step; null disables clipping. The norm is logged either way."
        },
        "grad_probes": {
            "default": false,
            "description": "Log the largest |gradient| at the two places in the NSS v1 torch postprocess that can amplify gradients (KPN weight sum, history-clamp variance), and the gradient norm at the history input of every recurrent frame after the first, per batch into train_steps.csv. Diagnostic, small cost.",
            "type": "boolean"
        },
        "history_grad_frames": {
            "anyOf": [
                {
                    "minimum": 1,
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Truncated backpropagation through time: every N recurrent frames the history buffers are detached, so a frame's loss reaches back at most N frames through the history; null backpropagates through the whole window."
        },
        "history_grad_clip": {
            "anyOf": [
                {
                    "exclusiveMinimum": 0.0,
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Clip the gradient flowing back into each recurrent buffer (history, temporal parameters, derivative) at every frame to this L2 norm per sample; smaller gradients pass unchanged, so calm steps keep full backpropagation. null disables. The per-frame history probes log the unclipped norm over the whole batch (about sqrt(batch size) times a per-sample norm)."
        },
        "compile_unit": {
            "default": "step",
            "description": "What torch.compile compiles: the whole recurrent forward (step) or only the model's one-frame core_forward, with the recurrent loop eager (frame; much faster to compile).",
            "enum": [
                "step",
                "frame"
            ],
            "type": "string"
        },
        "network_dtype": {
            "default": "fp32",
            "description": "Compute dtype of the neural network on CUDA: bf16 runs it under torch.autocast. Weights, optimizer state and the pre/post-processing stay fp32.",
            "enum": [
                "fp32",
                "bf16"
            ],
            "type": "string"
        },
        "validate_frequency": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "items": {
                        "type": "integer"
                    },
                    "type": "array"
                }
            ],
            "default": 1,
            "description": "For a single int, N, validate every N epochs. For a List of ints, run validation after each epoch in the List. If using with `perform_validate=true`, ensure that at least one validation pass will run within the total number of epochs, otherwise a ValueError is raised."
        },
        "fp32": {
            "number_of_epochs": {
                "description": "Number of epochs",
                "minimum": 1,
                "type": "integer"
            },
            "checkpoints": {
                "dir": {
                    "description": "Save directory for checkpoints",
                    "format": "path",
                    "type": "string"
                }
            },
            "lr_scheduler": {
                "description": "The Learning Rate Scheduler used during training. Can be one of: cosine_annealing, exponential_step, static",
                "discriminator": {
                    "propertyName": "type"
                },
                "oneOf": [
                    {
                        "type": {
                            "const": "cosine_annealing",
                            "type": "string"
                        },
                        "warmup_percentage": {
                            "description": "Proportion of training steps to linearly warm up the learning rate",
                            "exclusiveMaximum": 1.0,
                            "minimum": 0.0,
                            "type": "number"
                        },
                        "min_lr": {
                            "description": "Minimum learning rate reached after cosine decay.",
                            "maximum": 1.0,
                            "minimum": 0.0,
                            "type": "number"
                        }
                    },
                    {
                        "type": {
                            "const": "exponential_step",
                            "type": "string"
                        },
                        "decay_rate": {
                            "description": "Learning rate decay rate. Decay applied every step_size steps.",
                            "maximum": 1.0,
                            "minimum": 0.0,
                            "type": "number"
                        },
                        "decay_factor": {
                            "description": "Divisor for total number of iterations. The larger the value, the quicker the decay i.e. step_size = (epochs * dataset_size) / decay_factor",
                            "minimum": 1,
                            "type": "integer"
                        }
                    },
                    {
                        "type": {
                            "const": "static",
                            "type": "string"
                        }
                    }
                ]
            },
            "optimizer": {
                "optimizer_type": {
                    "description": "Optimizer type to use during training. Choose from: adam_w, lars_adam, adam",
                    "type": "string"
                },
                "learning_rate": {
                    "description": "The learning rate. Scheduler may override this value",
                    "exclusiveMinimum": 0.0,
                    "maximum": 1.0,
                    "type": "number"
                },
                "eps": {
                    "anyOf": [
                        {
                            "exclusiveMinimum": 0.0,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Optional epsilon value for optimizers that support it."
                }
            }
        },
        "qat": {
            "number_of_epochs": {
                "description": "Number of epochs",
                "minimum": 1,
                "type": "integer"
            },
            "checkpoints": {
                "dir": {
                    "description": "Save directory for checkpoints",
                    "format": "path",
                    "type": "string"
                }
            },
            "lr_scheduler": {
                "description": "The Learning Rate Scheduler used during training. Can be one of: cosine_annealing, exponential_step, static",
                "discriminator": {
                    "propertyName": "type"
                },
                "oneOf": [
                    {
                        "type": {
                            "const": "cosine_annealing",
                            "type": "string"
                        },
                        "warmup_percentage": {
                            "description": "Proportion of training steps to linearly warm up the learning rate",
                            "exclusiveMaximum": 1.0,
                            "minimum": 0.0,
                            "type": "number"
                        },
                        "min_lr": {
                            "description": "Minimum learning rate reached after cosine decay.",
                            "maximum": 1.0,
                            "minimum": 0.0,
                            "type": "number"
                        }
                    },
                    {
                        "type": {
                            "const": "exponential_step",
                            "type": "string"
                        },
                        "decay_rate": {
                            "description": "Learning rate decay rate. Decay applied every step_size steps.",
                            "maximum": 1.0,
                            "minimum": 0.0,
                            "type": "number"
                        },
                        "decay_factor": {
                            "description": "Divisor for total number of iterations. The larger the value, the quicker the decay i.e. step_size = (epochs * dataset_size) / decay_factor",
                            "minimum": 1,
                            "type": "integer"
                        }
                    },
                    {
                        "type": {
                            "const": "static",
                            "type": "string"
                        }
                    }
                ]
            },
            "optimizer": {
                "optimizer_type": {
                    "description": "Optimizer type to use during training. Choose from: adam_w, lars_adam, adam",
                    "type": "string"
                },
                "learning_rate": {
                    "description": "The learning rate. Scheduler may override this value",
                    "exclusiveMinimum": 0.0,
                    "maximum": 1.0,
                    "type": "number"
                },
                "eps": {
                    "anyOf": [
                        {
                            "exclusiveMinimum": 0.0,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Optional epsilon value for optimizers that support it."
                }
            }
        },
        "loss_fn": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Loss function to use. Choose from: loss_v1, lpips_spatial_loss_v1"
        },
        "loss_args": {
            "anyOf": [
                {},
                {
